DB_NAME=loom
DB_USER=dbaloom
DB_PASSWORD=change-me-database-password

JWT_SECRET=change-me-at-least-32-bytes-long-secret-value
JWT_TTL_MINUTES=480

# Immagine unica usata da compose.yml.
# Il workflow GitHub pubblica su ghcr.io/<owner>/loom.
LOOM_IMAGE=ghcr.io/davide-leva/loom:latest

# TLS via Let's Encrypt (Caddy).
# Set TLS_ENABLED=true once you have a public DNS A/AAAA record pointing to this host.
# Leave TLS_ENABLED=false for plain HTTP on :80 (local dev, LAN behind reverse proxy, ecc.).
TLS_ENABLED=false
DOMAIN=
ACME_EMAIL=

ATTACHMENTS_MAX_FILE_SIZE=25MB
ATTACHMENTS_MAX_REQUEST_SIZE=25M
# Per il backend avviato localmente: ROOT_FOLDER=./branding

MAIL_NOTIFICATIONS_ENABLED=false
MAIL_FROM=no-reply@loom.local
MAIL_NOTIFICATIONS_DELAY=10m
MAIL_NOTIFICATIONS_MIN_AGE=2m
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
